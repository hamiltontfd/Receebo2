modules = ["nodejs-24", "python-base-3.13", "postgresql-16"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "receiptr-tests"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "pwa-privacy-tests"

[[workflows.workflow]]
name = "receiptr-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/receiptr test"

[workflows.workflow.metadata]
isValidation = true

[[workflows.workflow]]
name = "pwa-privacy-tests"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pnpm --filter @workspace/receiptr exec vitest run --config vitest.api.config.ts src/routes/storagePrivacy.test.ts src/lib/objectStoragePrivacy.test.ts"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 8080
externalPort = 80

[[ports]]
localPort = 8081
externalPort = 8081

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
RESEND_FROM = "onboarding@resend.dev"
STRIPE_MONTHLY_PRICE_ID = "price_1Tx40jPNRVgRaJxMuAGxqGbK"
STRIPE_YEARLY_PRICE_ID = "price_1Tx40jPNRVgRaJxM0Rz7cxq6"

[userenv.development]
STRIPE_TEST_MONTHLY_PRICE_ID = "price_1Tx40jPNRVgRaJxMuAGxqGbK"
STRIPE_TEST_PORTAL_CONFIGURATION_ID = "bpc_1UUkj7PNRVgRaJxMRhSeEeWe"
STRIPE_TEST_YEARLY_PRICE_ID = "price_1Tx40jPNRVgRaJxM0Rz7cxq6"

[userenv.production]
STRIPE_LIVE_MONTHLY_PRICE_ID = "price_1U2Hx2AiALckJK9R0IfrcEem"
STRIPE_LIVE_PORTAL_CONFIGURATION_ID = "bpc_1UUkj5AiALckJK9RUEW3GxPY"
STRIPE_LIVE_YEARLY_PRICE_ID = "price_1U2Hx2AiALckJK9RQbcfs8Zt"
